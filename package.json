{
  "name": "hardkas-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Javier Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KasLabDevs/HardKas.git"
  },
  "homepage": "https://github.com/KasLabDevs/HardKas#readme",
  "engines": {
    "node": "24.22.1"
  },
  "bugs": {
    "url": "https://github.com/KasLabDevs/HardKas/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build --concurrency 1",
    "release:build": "node scripts/release-build.mjs",
    "dev": "turbo dev",
    "test": "vitest run && pnpm test:workflows",
    "test:hermetic": "node scripts/gate-hermetic.mjs",
    "test:simnet": "vitest run --config vitest.simnet.config.ts",
    "test:silverc": "vitest run --config vitest.silverc.config.ts",
    "test:silver-runner": "vitest run --config vitest.silver-runner.config.ts",
    "test:localnet": "vitest run --config vitest.localnet.config.ts",
    "test:e2e:docker": "vitest run --config vitest.e2e.config.ts --no-file-parallelism",
    "test:workflows": "vitest run packages/cli/test/workflow-corpus.test.ts",
    "bench": "vitest bench --run",
    "bench:docker": "tsx benchmarks/docker-long-run.ts --minutes 30",
    "bench:docker:smoke": "tsx benchmarks/docker-long-run.ts --minutes 3",
    "test:fuzz": "vitest run packages/testing/test/fuzz-policy.test.ts packages/testing/test/fuzz-network.test.ts packages/testing/test/fuzz-migration.test.ts",
    "test:fuzz:policy": "vitest run packages/testing/test/fuzz-policy.test.ts",
    "test:fuzz:network": "vitest run packages/testing/test/fuzz-network.test.ts",
    "test:fuzz:migration": "vitest run packages/testing/test/fuzz-migration.test.ts",
    "test:backward": "vitest run packages/testing/test/backward-compat.test.ts",
    "smoke:backward": "tsx packages/testing/scripts/smoke-backward-compat.ts",
    "packaging:smoke": "node scripts/check-packaging-smoke.mjs",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "docs:generate-cli": "pnpm --filter @hardkas/cli docs:generate-cli",
    "docs:check-cli": "pnpm --filter @hardkas/cli docs:check-cli",
    "docs:generate-apps-cli": "tsx apps/docs/scripts/cli-reference.mts --write",
    "docs:check-apps-cli": "tsx apps/docs/scripts/cli-reference.mts --check",
    "docs:generate-claims": "node scripts/generate-claims-docs.mjs",
    "docs:check-claims": "node scripts/generate-claims-docs.mjs --check",
    "docs:check-site": "node scripts/check-site-map.mjs",
    "site:build": "node scripts/build-unified-site.mjs",
    "site:test": "node scripts/test-unified-site.mjs",
    "hardkas": "pnpm --filter @hardkas/cli run dev",
    "cli": "pnpm --filter @hardkas/cli run dev",
    "check": "pnpm typecheck && pnpm build && pnpm version:check && pnpm docs:check-cli && pnpm docs:check-apps-cli && pnpm docs:check-claims && pnpm check:docs && pnpm test",
    "test:repro": "pnpm --filter @hardkas/testing test",
    "version:check": "node scripts/check-versions.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "pnpm --filter @hardkas/cli test:docs",
    "check:artifacts": "pnpm artifact:fixtures",
    "artifact:fixtures": "node scripts/check-artifact-fixtures.mjs packages/artifacts/test/fixtures/valid",
    "artifact:corruption": "node scripts/check-artifact-fixtures.mjs packages/artifacts/test/fixtures/corrupted --reject",
    "example:hello": "tsx examples/01-hello-kaspa/main.ts",
    "example:transfer": "tsx examples/02-basic-transfer/main.ts",
    "example:localnet": "tsx examples/03-localnet-demo/main.ts",
    "example:v0-demo": "tsx examples/02-basic-transfer/main.ts",
    "example:v1-demo": "tsx examples/07-v1-demo/main.ts",
    "example:covenant-demo": "tsx examples/08-covenant-core/main.ts",
    "example:trace": "pnpm --filter @examples/trace-and-replay start",
    "example:snapshot": "pnpm --filter @examples/snapshot-restore start",
    "example:rpc-health": "pnpm --filter @examples/rpc-node-health start",
    "smoke:external-tarball": "node scripts/check-packaging-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "gauntlet:toccata": "node scripts/toccata-gauntlet.mjs",
    "corpus:toccata": "tsx packages/cli/src/index.ts corpus verify fixtures/toccata-v2/silver --json --workspace .",
    "zk:corpus": "tsx packages/cli/src/index.ts zk corpus verify fixtures/toccata-v2/zk --json",
    "vprogs:check": "node scripts/vprogs-check.mjs",
    "programmability:corpus": "tsx packages/cli/src/index.ts programmability corpus verify fixtures/toccata-v2 --json",
    "programmability:templates": "node scripts/programmability-templates.mjs",
    "templates:verify": "node scripts/templates-verify.mjs",
    "postrelease:break": "node scripts/post-release-break-gauntlet.mjs",
    "docs:verify-book": "tsx scripts/verify-book.ts",
    "qualification:public-npm": "tsx scripts/qualification/public-npm-torture.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hardkas/cli": "workspace:*",
    "@hardkas/config": "workspace:*",
    "@hardkas/core": "workspace:*",
    "@hardkas/node-runner": "workspace:*",
    "@hardkas/sdk": "workspace:*",
    "@hardkas/testing": "workspace:*",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^2.1.9",
    "c8": "^11.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "knip": "^6.26.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  },
  "version": "0.13.0-rc.1",
  "dependencies": {},
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.7",
      "underscore": "1.13.8",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "body-parser@>=1 <1.20.9": "~1.20.9",
      "fast-uri@>=2 <2.4.8": "~2.4.8",
      "fast-uri@>=3 <3.1.9": "^3.1.9",
      "follow-redirects@<1.16.2": "^1.16.2",
      "joi@>=17 <17.13.9": "^17.13.9",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "launch-editor@<2.14.2": "^2.14.2",
      "markdown-it@>=14 <14.3.3": "^14.3.3",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "postcss-selector-parser@>=6 <6.1.5": "~6.1.5",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@>=6 <6.16.1": "^6.16.1",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "smol-toml@<1.9.0": "^1.9.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@>=7 <7.30.1": "^7.30.1"
    }
  }
}
