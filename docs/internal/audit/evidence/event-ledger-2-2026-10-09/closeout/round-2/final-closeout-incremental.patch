+      effect: { operation: "simulated-execution", outcome: "not-performed", txId: signed.txId },
+      receiptsPublished: 0
+    });
+    expect(doc.message).toMatch(/^Nothing was executed: the ledger failed before the simulator ran transaction synthetic-[0-9a-f]{64}\./);
