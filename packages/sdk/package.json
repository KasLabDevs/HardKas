{
  "name": "@hardkas/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Kaspa L1 apps and tests: plan, sign, send and verify transactions on a simulated ledger or a simnet node, built on the official kaspa-wasm.",
  "keywords": ["hardkas", "kaspa", "kaspa-l1", "blockdag", "utxo", "developer-tools", "sdk", "typescript", "silverscript", "covenants", "toccata", "kaspa-wasm", "wallet", "simnet"],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean --external @hardkas/pskt-native",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hardkas/accounts": "workspace:*",
    "@hardkas/artifacts": "workspace:*",
    "@hardkas/config": "workspace:*",
    "@hardkas/core": "workspace:*",
    "@hardkas/kaspa-rpc": "workspace:*",
    "@hardkas/localnet": "workspace:*",
    "@hardkas/node-runner": "workspace:*",
    "@hardkas/query": "workspace:*",
    "@hardkas/query-store": "workspace:*",
    "@hardkas/toolkit": "workspace:*",
    "@hardkas/tx-builder": "workspace:*"
  },
  "peerDependencies": {
    "snarkjs": "0.7.6"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/snarkjs": "0.7.9",
    "snarkjs": "0.7.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "Javier Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KasLabDevs/HardKas.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/KasLabDevs/HardKas/issues"
  },
  "homepage": "https://hardkas.dev/docs/",
  "publishConfig": {
    "access": "public"
  }
}
