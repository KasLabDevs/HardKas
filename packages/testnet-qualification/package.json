{
  "name": "@hardkas/testnet-qualification",
  "version": "0.12.0-rc.21",
  "private": true,
  "type": "module",
  "description": "Internal HardKAS testnet qualification runner (TQ-1). Not published; never depended on by production packages.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hardkas/core": "workspace:*",
    "@hardkas/tx-builder": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "Javier Rodriguez"
}
