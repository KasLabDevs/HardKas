{
  "name": "@hardkas/testing",
  "version": "0.12.0-rc.18",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js",
      "default": "./dist/harness.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "default": "./dist/setup.js"
    },
    "./adversarial-fixtures": {
      "types": "./dist/adversarial-fixtures.d.ts",
      "import": "./dist/adversarial-fixtures.js",
      "default": "./dist/adversarial-fixtures.js"
    },
    "./mass-setup": {
      "types": "./dist/mass-setup.d.ts",
      "import": "./dist/mass-setup.js",
      "default": "./dist/mass-setup.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "import": "./dist/scenarios.js",
      "default": "./dist/scenarios.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/scenarios.ts src/harness.ts src/setup.ts src/reproducibility.ts src/adversarial-fixtures.ts src/mass-setup.ts --format esm --dts --clean --external vitest --external kaspa",
    "test": "vitest run && pnpm test:gauntlet",
    "test:gauntlet": "node --import tsx --test test/gauntlet.node.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hardkas/accounts": "workspace:*",
    "@hardkas/artifacts": "workspace:*",
    "@hardkas/core": "workspace:*",
    "@hardkas/kaspa-rpc": "workspace:*",
    "@hardkas/localnet": "workspace:*",
    "@hardkas/query-store": "workspace:*",
    "@hardkas/sdk": "workspace:*",
    "@hardkas/simulator": "workspace:*",
    "@hardkas/tx-builder": "workspace:*"
  },
  "devDependencies": {
    "execa": "^9.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "Javier Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KasLabDevs/HardKas.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/KasLabDevs/HardKas/issues"
  },
  "homepage": "https://github.com/KasLabDevs/HardKas/tree/main/packages/testing#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
