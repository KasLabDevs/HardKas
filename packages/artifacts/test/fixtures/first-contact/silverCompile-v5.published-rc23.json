    "text": "pragma silverscript ^0.1.0;\n\n// Fixed-destination P2SH contract: the first output must pay one recipient.\n// (A covenant in the classic sense; not a Toccata covenant declaration.)\ncontract SimpleCovenant() {\n    entry spend() {\n        // Recipient pubkey of the private key 2222...2222 (x-only).\n        pubkey recipient = pubkey(0x466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27);\n        byte[] recipientScriptPubKey = byte[](new ScriptPubKeyP2PK(recipient));\n\n        // Ensure that the first output sends to the recipient\n        require(tx.outputs[0].scriptPubKey == recipientScriptPubKey);\n    }\n}"
  },
