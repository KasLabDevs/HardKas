{
  "name": "@hardkas/query",
  "version": "0.13.0-rc.3",
  "description": "Queries over the artifacts and query store of a HardKAS workspace (Kaspa L1): artifacts, lineage, replay, DAG, events and transactions.",
  "keywords": ["hardkas", "kaspa", "kaspa-l1", "blockdag", "utxo", "developer-tools", "query", "lineage"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hardkas/artifacts": "workspace:*",
    "@hardkas/core": "workspace:*",
    "@hardkas/query-store": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "license": "MIT",
  "author": "Javier Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KasLabDevs/HardKas.git",
    "directory": "packages/query"
  },
  "bugs": {
    "url": "https://github.com/KasLabDevs/HardKas/issues"
  },
  "homepage": "https://hardkas.dev/docs/",
  "publishConfig": {
    "access": "public"
  }
}
